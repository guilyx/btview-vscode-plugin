<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="PngWithMidCourseFallback">
  <BehaviorTree ID="PngWithMidCourseFallback">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <Action ID="Wait" duration_ms="20"/>
          <Condition ID="ReadyForPNGCondition" ground_speed_threshold_m_s="15.0" time_to_go_threshold_s="30.5" los_rate_threshold_rad_s="0.0" max_data_age_sec="0.45" validity_cycles="5" check_gimbal_tracking="{check_gimbal_tracking}"/>
        </Sequence>
      </RetryUntilSuccessful>
      <Action ID="SetControlOutput" service_name="controller_multiplexer/set_control_mode" linear_mode="PNG" yaw_mode="{terminal_heading_mode}" linear_transition_dur_s="1.0" yaw_transition_dur_s="1.5"/>
      <Action ID="Wait" duration_ms="150"/>
      <KeepRunningUntilFailure>
        <RetryUntilSuccessElse num_attempts="4">
          <Sequence>
            <Condition ID="ReadyForPNGCondition" ground_speed_threshold_m_s="15.0" time_to_go_threshold_s="40.0" los_rate_threshold_rad_s="0.0" max_data_age_sec="0.45" validity_cycles="1" check_gimbal_tracking="{check_gimbal_tracking}"/>
          </Sequence>
          <Sequence>
            <Action ID="SetControlOutput" service_name="controller_multiplexer/set_control_mode" linear_mode="predictive_pursuit" yaw_mode="predictive_pursuit" linear_transition_dur_s="3.0" yaw_transition_dur_s="2.0"/>
            <RetryUntilSuccessful num_attempts="-1">
              <Sequence>
                <Action ID="Wait" duration_ms="20"/>
                <Condition ID="ReadyForPNGCondition" ground_speed_threshold_m_s="15.0" time_to_go_threshold_s="40.0" los_rate_threshold_rad_s="0.0" max_data_age_sec="0.45" validity_cycles="5" check_gimbal_tracking="{check_gimbal_tracking}"/>
              </Sequence>
            </RetryUntilSuccessful>
            <Action ID="SetControlOutput" service_name="controller_multiplexer/set_control_mode" linear_mode="PNG" yaw_mode="{terminal_heading_mode}" linear_transition_dur_s="1.0" yaw_transition_dur_s="1.5"/>
            <Action ID="Wait" duration_ms="20"/>
          </Sequence>
        </RetryUntilSuccessElse>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>
</root>