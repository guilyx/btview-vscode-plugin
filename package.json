{
  "name": "btview",
  "displayName": "BTView — Behavior Tree Editor",
  "description": "Visual graph editor for BehaviorTree.CPP v3.8 and v4 XML files",
  "version": "0.1.0",
  "publisher": "your-publisher",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/btview-vscode-plugin"
  },
  "bugs": {
    "url": "https://github.com/your-org/btview-vscode-plugin/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "behavior-tree",
    "btcpp",
    "ros2",
    "robotics",
    "xml"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "btview.ping",
        "title": "BTView Ping",
        "category": "BTView"
      }
    ],
    "menus": {},
    "configuration": {
      "title": "BTView",
      "properties": {}
    }
  },
  "scripts": {
    "compile": "bash scripts/with-node.sh npm run compile:inner",
    "compile:inner": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "bash scripts/with-node.sh npm run watch:inner",
    "watch:inner": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "watch:webview": "npm run build:webview -- --watch",
    "build:webview": "vite build --config webview/vite.config.ts",
    "vscode:prepublish": "npm run package",
    "package": "bash scripts/with-node.sh npm run package:inner",
    "package:inner": "npm run check-types && node esbuild.js --production && npm run build:webview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "pre-commit run --all-files",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "echo \"skip\"",
    "pretest:integration": "echo \"integration tests added in PR6\"",
    "pretest:integration:inner": "npm run compile:inner && tsc -p tsconfig.test.json",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.3.0",
    "@xyflow/react": "^12.6.0",
    "elkjs": "^0.10.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.0",
    "fast-xml-parser": "^5.0.9",
    "globals": "^17.6.0",
    "mocha": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.0",
    "react": "^19.2.7",
    "react-dom": "^18.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
