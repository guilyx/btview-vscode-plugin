{
  "name": "btview",
  "displayName": "BTView — Behavior Tree Editor",
  "description": "Visual graph editor for BehaviorTree.CPP v3.8 and v4 XML files",
  "version": "0.9.0",
  "publisher": "rangonomics",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "homepage": "https://github.com/guilyx/btview-vscode-plugin#readme",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "BTView reads and writes behavior tree XML files in the workspace."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guilyx/btview-vscode-plugin"
  },
  "bugs": {
    "url": "https://github.com/guilyx/btview-vscode-plugin/issues"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "behavior-tree",
    "btcpp",
    "ros2",
    "robotics",
    "xml"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:xml",
    "onCustomEditor:btview.graph"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "btview.graph",
        "displayName": "BT Graph",
        "selector": [
          {
            "filenamePattern": "*.xml"
          },
          {
            "filenamePattern": "*.bt.xml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "btview.openPreview",
        "title": "Open BT Graph",
        "category": "BTView",
        "icon": {
          "light": "media/icons/graph-light.svg",
          "dark": "media/icons/graph-dark.svg"
        }
      },
      {
        "command": "btview.openPreviewSide",
        "title": "Open BT Graph to the Side",
        "category": "BTView",
        "icon": {
          "light": "media/icons/graph-light.svg",
          "dark": "media/icons/graph-dark.svg"
        }
      },
      {
        "command": "btview.openSource",
        "title": "Open XML Source",
        "category": "BTView",
        "icon": {
          "light": "media/icons/xml-light.svg",
          "dark": "media/icons/xml-dark.svg"
        }
      },
      {
        "command": "btview.convertToV4",
        "title": "Convert to BTCpp v4",
        "category": "BTView"
      },
      {
        "command": "btview.newTree",
        "title": "New Behavior Tree",
        "category": "BTView"
      },
      {
        "command": "btview.graph.undo",
        "title": "Undo Graph Edit",
        "category": "BTView"
      },
      {
        "command": "btview.graph.redo",
        "title": "Redo Graph Edit",
        "category": "BTView"
      },
      {
        "command": "btview.exportWorkspaceConfig",
        "title": "Export Workspace Config (Save Types)",
        "category": "BTView"
      },
      {
        "command": "btview.graph.fitView",
        "title": "Fit Graph View",
        "category": "BTView"
      },
      {
        "command": "btview.graph.toggleLegend",
        "title": "Toggle Color Legend",
        "category": "BTView"
      },
      {
        "command": "btview.graph.togglePorts",
        "title": "Toggle Port Labels",
        "category": "BTView"
      },
      {
        "command": "btview.graph.focusSearch",
        "title": "Focus Node Search",
        "category": "BTView"
      },
      {
        "command": "btview.graph.deleteNode",
        "title": "Delete Selected Node",
        "category": "BTView"
      },
      {
        "command": "btview.graph.showShortcutHelp",
        "title": "Show Keyboard Shortcuts",
        "category": "BTView"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "btview.openPreview",
          "alt": "btview.openPreviewSide",
          "when": "editorLangId == xml && activeCustomEditorId != 'btview.graph'",
          "group": "navigation"
        },
        {
          "command": "btview.openSource",
          "when": "activeCustomEditorId == 'btview.graph'",
          "group": "navigation"
        }
      ],
      "webview/title": [
        {
          "command": "btview.openSource",
          "when": "activeWebviewPanelId == 'btview.preview'",
          "group": "navigation@1"
        },
        {
          "command": "btview.openPreview",
          "when": "activeWebviewPanelId == 'btview.preview'",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "btview.openPreview",
          "when": "resourceExtname == .xml",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "btview.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == xml && editorTextFocus"
      },
      {
        "command": "btview.openPreviewSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == xml && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "BTView",
      "properties": {
        "btview.rosDistro": {
          "type": "string",
          "default": "",
          "description": "ROS distro for package resolution (auto-detect if empty)."
        },
        "btview.rosWorkspaceSetup": {
          "type": "string",
          "default": "",
          "description": "Path to setup.bash/setup.zsh to source before ros2 pkg prefix."
        },
        "btview.rosPackageShareOverrides": {
          "type": "object",
          "default": {},
          "description": "Map package name to share directory override."
        },
        "btview.defaultFormatVersion": {
          "type": "string",
          "enum": [
            "auto",
            "3",
            "4"
          ],
          "default": "auto",
          "description": "Default BTCpp format when BTCPP_format is absent (auto = v3.8)."
        },
        "btview.serializeNewFilesAs": {
          "type": "string",
          "enum": [
            "3",
            "4"
          ],
          "default": "4",
          "description": "Format version for newly created BT XML files."
        },
        "btview.defaultOpenMode": {
          "type": "string",
          "enum": [
            "text",
            "graph",
            "side"
          ],
          "default": "text",
          "description": "When opening a BTCpp XML file: text editor only, BT Graph custom editor, or XML + side graph preview."
        },
        "btview.nodeTypeMap": {
          "type": "object",
          "default": {},
          "markdownDescription": "Map custom node registered IDs to kinds. Keys are node IDs (e.g. `NavigateToGoal`); values are one of `action`, `condition`, `control`, `decorator`, `subtree`, or `script`. Used when parsing XML and populating the add-node palette.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "action",
              "condition",
              "control",
              "decorator",
              "subtree",
              "script"
            ]
          }
        },
        "btview.showNodePorts": {
          "type": "boolean",
          "default": false,
          "description": "Show port value chips on graph nodes when enabled (toggle with Ctrl+Alt+P in graph)."
        },
        "btview.customModelsInclude": {
          "type": "string",
          "default": ".btview/models.xml",
          "description": "Relative path for exported TreeNodesModel file when using Save custom types to workspace."
        },
        "btview.simpleMode": {
          "type": "boolean",
          "default": false,
          "description": "Hide advanced graph menus (cut subtree, export config) for a simpler editing experience."
        }
      }
    }
  },
  "scripts": {
    "compile": "bash scripts/with-node.sh npm run compile:inner",
    "compile:inner": "npm run check-types && node esbuild.js && npm run build:webview",
    "check-types": "tsc --noEmit",
    "watch": "bash scripts/with-node.sh npm run watch:inner",
    "watch:inner": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "watch:webview": "npm run build:webview -- --watch",
    "build:webview": "vite build --config webview/vite.config.ts",
    "vscode:prepublish": "npm run package",
    "package": "bash scripts/with-node.sh npm run package:inner",
    "package:inner": "npm run check-types && node esbuild.js --production && npm run build:webview",
    "lint": "eslint src webview/src",
    "lint:fix": "eslint src webview/src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "pre-commit run --all-files",
    "verify": "bash scripts/verify.sh",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vscode-test",
    "pretest:integration": "bash scripts/with-node.sh npm run pretest:integration:inner",
    "pretest:integration:inner": "npm run compile:inner && tsc -p tsconfig.test.json",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.3.0",
    "@xyflow/react": "^12.11.1",
    "elkjs": "^0.11.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.0",
    "fast-xml-parser": "^5.9.3",
    "globals": "^17.7.0",
    "mocha": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.9"
  }
}
